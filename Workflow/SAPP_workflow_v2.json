      "parameters": {
        "jsCode": "// 1. Intentamos obtener la raíz de los datos de todas las formas posibles\nconst input = $input.first().json;\nconst dataRoot = input.datos_recibidos?.output || input.output || input;\n\n// 2. Buscamos la lista de artículos\nconst items = dataRoot.pedido?.items || dataRoot.items;\n\n// 3. Si no es una lista válida, enviamos un error amigable en lugar de romperse\nif (!Array.isArray(items)) {\n  return [{ \n    json: { \n      error: \"No se encontró la lista\", \n      llaves_vistas: Object.keys(input) \n    } \n  }];\n}\n\n// 4. Si llegamos aquí, la lista existe. La enviamos a Sheets.\nreturn items.map(item => ({\n  json: {\n    Articulo: item.articulo,\n    Cantidad: item.cantidad,\n    Unidad: item.unidad\n  }\n}));"
      },
