        "jsCode": "const llmOutput = $('Basic LLM Chain1').first().json.output;\nconst pedidos = llmOutput.pedidos;\n\nconst newItems = pedidos.map(p => ({\n  json: {\n    producto: String(p.producto || \"\"),\n    cantidad: Number(p.cantidad || 0)\n  }\n}));\n\nif (newItems.length === 0) {\n  newItems.push({ json: { producto: \"\", cantidad: 0 } });\n}\n\nreturn newItems;"
